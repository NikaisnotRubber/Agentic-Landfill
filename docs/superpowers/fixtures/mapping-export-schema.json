{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Platform mapping export contract (ad_user_vm_mapping.xlsx)",
  "version": "1.0.0",
  "description": "Single source of truth for mapping_row DB columns and external Excel/CSV export. Ticket workbook (ddp_ticket_maintain.xlsx) uses mappingFieldId where noted.",
  "grain": {
    "description": "One export row per ad_members row after left join to role_user and servers (same as ddp_analysis.ipynb final query). Not one row per person.",
    "reference": "Mapping ADGroup、Zentera/docs/ddp_analysis_review.md §2"
  },
  "columns": [
    {
      "excelHeader": "AD Account",
      "dbColumn": "ad_account",
      "mappingFieldId": "adAccount",
      "logicalType": "ad_account",
      "storageType": "text",
      "exportType": "string",
      "nullable": false,
      "defaultWhenNull": "",
      "transform": { "trim": true, "uppercase": true },
      "readonly": true,
      "inTicketWorkbook": true
    },
    {
      "excelHeader": "AD Name (Chinese Name)",
      "dbColumn": "ad_name",
      "mappingFieldId": "adName",
      "logicalType": "display_name",
      "storageType": "text",
      "exportType": "string",
      "nullable": true,
      "defaultWhenNull": "",
      "transform": { "trim": true },
      "readonly": true,
      "inTicketWorkbook": true,
      "ticketExcelHeader": "AD Name (Chinese Name)"
    },
    {
      "excelHeader": "FirstName",
      "dbColumn": "first_name",
      "mappingFieldId": "firstName",
      "logicalType": "person_name",
      "storageType": "text",
      "exportType": "string",
      "nullable": true,
      "defaultWhenNull": "",
      "transform": { "trim": true },
      "readonly": true,
      "inTicketWorkbook": true
    },
    {
      "excelHeader": "LastName",
      "dbColumn": "last_name",
      "mappingFieldId": "lastName",
      "logicalType": "person_name",
      "storageType": "text",
      "exportType": "string",
      "nullable": true,
      "defaultWhenNull": "",
      "transform": { "trim": true },
      "readonly": true,
      "inTicketWorkbook": true
    },
    {
      "excelHeader": "Mail",
      "dbColumn": "mail",
      "mappingFieldId": "mail",
      "logicalType": "email",
      "storageType": "text",
      "exportType": "string",
      "nullable": true,
      "defaultWhenNull": "",
      "transform": { "trim": true, "lowercase": true },
      "readonly": true,
      "inTicketWorkbook": true,
      "notes": "Ticket export may apply resolveExportMail(adAccount) when empty; mapping export uses stored mail only unless product decides otherwise."
    },
    {
      "excelHeader": "BG",
      "dbColumn": "bg",
      "mappingFieldId": "bg",
      "logicalType": "org_unit",
      "storageType": "text",
      "exportType": "string",
      "nullable": true,
      "defaultWhenNull": "",
      "transform": { "trim": true },
      "readonly": true,
      "inTicketWorkbook": false
    },
    {
      "excelHeader": "BU",
      "dbColumn": "bu",
      "mappingFieldId": "bu",
      "logicalType": "org_unit",
      "storageType": "text",
      "exportType": "string",
      "nullable": true,
      "defaultWhenNull": "",
      "transform": { "trim": true },
      "readonly": true,
      "inTicketWorkbook": true
    },
    {
      "excelHeader": "Role",
      "dbColumn": "role_export",
      "mappingFieldId": "role",
      "logicalType": "role_code",
      "storageType": "text",
      "exportType": "string",
      "nullable": true,
      "defaultWhenNull": "",
      "transform": { "trim": true },
      "readonly": false,
      "derivedFrom": "role_inferred",
      "inTicketWorkbook": true,
      "notes": "Notebook infers from VM HostName via ([A-Za-z]{2})\\d+$; store role_inferred + optional role_override; export role_export."
    },
    {
      "excelHeader": "NB Hostname",
      "dbColumn": "nb_hostname",
      "mappingFieldId": "nbHostname",
      "logicalType": "hostname",
      "storageType": "text",
      "exportType": "string",
      "nullable": true,
      "defaultWhenNull": "",
      "transform": { "trim": true, "maxLength": 11 },
      "readonly": false,
      "inTicketWorkbook": true,
      "notes": "Often empty in mapping export; populated from ticket description in helpdesk flow."
    },
    {
      "excelHeader": "Group Owner",
      "dbColumn": "group_owner",
      "mappingFieldId": "groupOwner",
      "logicalType": "ad_group",
      "storageType": "text",
      "exportType": "string",
      "nullable": true,
      "defaultWhenNull": "",
      "transform": { "trim": true },
      "readonly": true,
      "inTicketWorkbook": true,
      "ticketExportDefault": "G-Delta-rollout_admin"
    },
    {
      "excelHeader": "Group Name",
      "dbColumn": "group_name",
      "mappingFieldId": "groupName",
      "logicalType": "ad_group",
      "storageType": "text",
      "exportType": "string",
      "nullable": true,
      "defaultWhenNull": "",
      "transform": { "trim": true },
      "readonly": true,
      "inTicketWorkbook": true
    },
    {
      "excelHeader": "NAS Folder Name",
      "dbColumn": "nas_folder_name",
      "mappingFieldId": "nasFolderName",
      "logicalType": "delivery_note",
      "storageType": "text",
      "exportType": "string",
      "nullable": true,
      "defaultWhenNull": "",
      "transform": { "trim": true },
      "readonly": false,
      "inTicketWorkbook": true,
      "editableInPlatformV1": true
    },
    {
      "excelHeader": "VM HostName",
      "dbColumn": "vm_hostname",
      "mappingFieldId": "vmHostname",
      "logicalType": "hostname",
      "storageType": "text",
      "exportType": "string",
      "nullable": true,
      "defaultWhenNull": "",
      "transform": { "trim": true, "uppercase": true },
      "readonly": true,
      "inTicketWorkbook": true
    },
    {
      "excelHeader": "Host IP",
      "dbColumn": "host_ip",
      "mappingFieldId": "hostIp",
      "logicalType": "ipv4",
      "storageType": "text",
      "exportType": "string",
      "nullable": true,
      "defaultWhenNull": "",
      "transform": { "trim": true },
      "readonly": true,
      "inTicketWorkbook": false,
      "decisionId": "D-TICKET-01",
      "notes": "Present in ad_user_vm_mapping.xlsx; not in ddp_ticket_maintain.xlsx today. Add ticket column in PLAT-006 if product confirms."
    },
    {
      "excelHeader": "NEW VM",
      "dbColumn": "new_vm",
      "mappingFieldId": "newVm",
      "logicalType": "delivery_flag",
      "storageType": "text",
      "exportType": "string",
      "nullable": true,
      "defaultWhenNull": "",
      "transform": { "trim": true },
      "readonly": false,
      "inTicketWorkbook": true,
      "editableInPlatformV1": true
    },
    {
      "excelHeader": "User Roles",
      "dbColumn": "user_roles",
      "mappingFieldId": "userRoles",
      "logicalType": "role_list",
      "storageType": "text",
      "exportType": "string",
      "nullable": true,
      "defaultWhenNull": "",
      "transform": { "join": ", ", "sortParts": false, "trim": true },
      "readonly": true,
      "inTicketWorkbook": true,
      "notes": "Comma-separated DDP role names for the user context in this row."
    },
    {
      "excelHeader": "Application",
      "dbColumn": "application",
      "mappingFieldId": "application",
      "logicalType": "zentera_application",
      "storageType": "text",
      "exportType": "string",
      "nullable": true,
      "defaultWhenNull": "",
      "transform": { "trim": true },
      "readonly": true,
      "inTicketWorkbook": true
    },
    {
      "excelHeader": "Template Name",
      "dbColumn": "template_name",
      "mappingFieldId": "templateName",
      "logicalType": "delivery_note",
      "storageType": "text",
      "exportType": "string",
      "nullable": true,
      "defaultWhenNull": "",
      "transform": { "trim": true },
      "readonly": false,
      "inTicketWorkbook": true,
      "editableInPlatformV1": true
    },
    {
      "excelHeader": "Location",
      "dbColumn": "location",
      "mappingFieldId": "location",
      "logicalType": "delivery_note",
      "storageType": "text",
      "exportType": "string",
      "nullable": true,
      "defaultWhenNull": "",
      "transform": { "trim": true },
      "readonly": false,
      "inTicketWorkbook": true,
      "editableInPlatformV1": true
    }
  ],
  "ticketOnlyColumns": [
    {
      "excelHeader": "Ticket ID",
      "dbColumn": null,
      "logicalType": "ticket_id",
      "exportType": "string"
    },
    {
      "excelHeader": "異常",
      "dbColumn": null,
      "logicalType": "abnormal_marker",
      "exportType": "string"
    },
    {
      "excelHeader": "工單狀態",
      "dbColumn": null,
      "logicalType": "ticket_status",
      "exportType": "string"
    }
  ],
  "internalColumns": [
    { "dbColumn": "id", "storageType": "uuid", "export": false },
    { "dbColumn": "batch_id", "storageType": "uuid", "export": false },
    { "dbColumn": "role_inferred", "storageType": "text", "export": false },
    { "dbColumn": "role_override", "storageType": "text", "export": false },
    { "dbColumn": "source_ad_member_row_id", "storageType": "uuid", "export": false },
    { "dbColumn": "created_at", "storageType": "timestamptz", "export": false }
  ]
}
