# Platform mapping DB (Track B)
# SQLite file path (default: data/platform.db)
DATABASE_URL=file:./data/platform.db

# When "1", Helpdesk enrich prefers published mapping_row over live Zentera CSV indexes
USE_PLATFORM_MAPPING_DB=0

# When "1" (default), Processed rows upsert into mapping_row (source_kind=ticket)
PLATFORM_SYNC_TICKETS=1
